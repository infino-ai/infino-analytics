# Copy to .env and fill in, then load it into your shell before running:
#
#   set -a; source .env; set +a
#   npm run dev
#
# (The kit deliberately ships without a dotenv loader; use your process
# manager's env handling in real deployments.)

# ── required ────────────────────────────────────────────────────────────────

# Your Infino database: https://<host>/<database>
INFINO_URI=https://api.platform.infino.ws/<database>

# Bearer key for that database
INFINO_API_KEY=

# Which LLM harness answers questions — no default, pick one explicitly:
#   claude  the Claude Agent SDK (needs ANTHROPIC_API_KEY below)
#   openai  the OpenAI Responses API (needs the OPENAI_* block below)
# A fork runs one: delete the packages/agents/* you did not pick, its
# apps/server dependency, and its HARNESSES entry, and its SDK is gone.
FINO_HARNESS=claude

# LLM credential for the Fino agent — the one your FINO_HARNESS needs, and
# only for ask()/chat; the visualization and dashboard APIs run without either.
# Leave this blank when FINO_HARNESS=openai.
ANTHROPIC_API_KEY=

# ── optional ────────────────────────────────────────────────────────────────

# Anthropic model id for the agent (default: claude-opus-5)
#FINO_MODEL=claude-opus-5

# Operator notes about the dataset — business definitions, reference tables
# (e.g. a topic taxonomy), naming conventions. Appended to the system prompt
# as ground truth, so the agent uses your definitions instead of inventing
# its own. Applies to whichever harness runs.
#FINO_DOMAIN_CONTEXT=

# Per-question agent ceilings. Raise them for work that legitimately runs
# long, such as exhaustive enumeration or corpus-wide verification.
# FINO_MAX_TURNS reaches either harness; the cost ceiling is per provider,
# because they bill differently.
#FINO_MAX_TURNS=25
#FINO_MAX_BUDGET_USD=2          # claude only — dollars (default 2)
#FINO_MAX_TOTAL_TOKENS=400000   # openai only — billed tokens (default 400k)

# ── OpenAI harness (required when FINO_HARNESS=openai) ─────────────────────

# Full API base — no path is built for you.
#   OpenAI: https://api.openai.com/v1
#   Azure:  https://<resource>.openai.azure.com/openai/v1
#OPENAI_BASE_URL=https://api.openai.com/v1

# Sent as a bearer token (on Azure too; the v1 surface takes no api-version)
#OPENAI_API_KEY=

# Model id, or an Azure deployment name
#OPENAI_MODEL=gpt-5.4

# Reasoning tier: none | low | medium | high. Unset lets the provider choose,
# which on some models means none at all — set it if you want reasoning.
#OPENAI_REASONING_EFFORT=low

# Where threads/visualizations/dashboards persist (the reference
# implementation is a local SQLite file; implement StorageAdapter over your
# own database to swap it)
#FINO_DB=./data/analytics.db

# Suggested-question chips for the demo UI, pipe-separated; write ones that
# fit your data
#FINO_SUGGESTIONS="Which features have the most denials?|Show the daily trend of denials"

# Reference server port (default 8787)
#PORT=8787
