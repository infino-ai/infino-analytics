# Copy to .env and fill in, then load it into your shell before running:
#
#   set -a; source .env; set +a
#   npm run dev
#
# (The kit deliberately ships without a dotenv loader; use your process
# manager's env handling in real deployments.)

# ── required ────────────────────────────────────────────────────────────────

# Your Infino database: https://<host>/<database>
INFINO_URI=https://api.platform.infino.ws/<database>

# Bearer key for that database
INFINO_API_KEY=

# LLM credential for the Fino agent (only ask()/chat needs it; the
# visualization and dashboard APIs run without it). Required by the default
# harness; the OpenAI harness below uses OPENAI_API_KEY instead.
ANTHROPIC_API_KEY=

# ── optional ────────────────────────────────────────────────────────────────

# Which LLM harness answers questions: "claude" (default, Claude Agent SDK)
# or "openai" (the Responses API — needs the OPENAI_* block below)
#FINO_HARNESS=claude

# Anthropic model id for the agent (default: claude-opus-5)
#FINO_MODEL=claude-opus-5

# ── OpenAI harness (only when FINO_HARNESS=openai) ─────────────────────────

# Full API base — no path is built for you.
#   OpenAI: https://api.openai.com/v1
#   Azure:  https://<resource>.openai.azure.com/openai/v1
#OPENAI_BASE_URL=https://api.openai.com/v1

# Sent as a bearer token (on Azure too; the v1 surface takes no api-version)
#OPENAI_API_KEY=

# Model id, or an Azure deployment name
#OPENAI_MODEL=gpt-5.4

# Where threads/visualizations/dashboards persist (the reference
# implementation is a local SQLite file; implement StorageAdapter over your
# own database to swap it)
#FINO_DB=./data/analytics.db

# Suggested-question chips for the demo UI, pipe-separated; write ones that
# fit your data
#FINO_SUGGESTIONS=Which features have the most denials?|Show the daily trend of denials

# Reference server port (default 8787)
#PORT=8787
