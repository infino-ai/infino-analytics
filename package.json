{
  "name": "infino-analytics",
  "private": true,
  "version": "0.0.0",
  "description": "Reference kit for building conversational analytics, visualizations, and dashboards on Infino",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/agents/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json",
    "test": "node --import tsx --test \"packages/**/test/**/*.test.ts\"",
    "build": "npm run build -w @infino-ai/analytics-web",
    "dev": "npm run build -w @infino-ai/analytics-web && npm run dev -w @infino-ai/analytics-server"
  },
  "license": "Apache-2.0"
}
